#include<bits/stdc++.h>
#define ll long long
using namespace std;
const ll mod=1e9+7;
ll biendoi(string s){
	reverse(s.begin(),s.end());
	ll res=0;
	for(int i=0;i<s.size();i++){
		ll bin=pow(2,i);
		if(s[i]=='1')	res+=bin;
	}
	return res;
}
int main(){
	int t;
	cin>>t;cin.ignore();
	while(t--){
		string s1,s2;
		cin>>s1>>s2;
		ll so1=biendoi(s1);
		ll so2=biendoi(s2);
		cout<<so1*so2<<endl;
	}
	return 0;
}
