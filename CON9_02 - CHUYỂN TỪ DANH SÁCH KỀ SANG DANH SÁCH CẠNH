#include<bits/stdc++.h>
using namespace std;
int main(){
	int n;
	cin>>n;
	vector<int> adj[1005];
	cin.ignore();
	for(int i=1;i<=n;i++){
		string s;
		getline(cin,s);
		stringstream ss(s);
		int j;
		while(ss>>j){
			if(j>i)	adj[i].push_back(j);
		}
	}
	for(int i=1;i<=n;i++){
		for(int j:adj[i])	cout<<i<<" "<<j<<endl;
	}
	return 0;
}
