#include<bits/stdc++.h>
#define ll long long 
using namespace std;
ll find(ll pos,ll n,ll ctr){
	if(pos==1)	return 1;
	if(pos==ctr)	return n%2;
	if(pos>ctr)	return find(pos-ctr,n/2,ctr/2);
	return find(pos,n/2,ctr/2);
}
int main(){
	int t;
	cin>>t;
	while(t--){
		ll n,l,r;
		cin>>n>>l>>r;
		ll ctr=pow(2,(ll)log2(n));
		ll res=0;
		for(ll i=l;i<=r;i++){
			res+=find(i,n,ctr);
		}
		cout<<res<<endl;
	}
	return 0;
}
