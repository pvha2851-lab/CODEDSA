#include<bits/stdc++.h>
using namespace std;
bool cmp(pair<int,int>s1,pair<int,int>s2){
	if(s1.second==s2.second)	return s1.first<s2.first;
	return s1.second>s2.second;
}
int main(){
	int t;
	cin>>t;
	while(t--){
		int n;
		cin>>n;
		map<int,int> a;
		for(int i=0;i<n;i++){
			int x;cin>>x;
			a[x]++;
		}
		vector<pair<int,int>> b;
		for(auto p:a){
			b.push_back({p.first,p.second});
		}
		sort(b.begin(),b.end(),cmp);
		for(auto p:b){
			for(int i=1;i<=p.second;i++){
				cout<<p.first<<" ";
			}
		}
		cout<<endl;
	}
	return 0;
}
